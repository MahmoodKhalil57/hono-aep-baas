{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mizan-gpp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  // The dogfooded studio bundle (bun scripts/build-studio.ts) — /studio
  // resolves to studio.html; unmatched paths fall through to the worker.
  "assets": { "directory": "./dist/studio-assets" },
  "triggers": { "crons": ["* * * * *"] },
  "ai": { "binding": "AI" },
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "mizan-gpp-media" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "mizan-gpp", "database_id": "9f343c55-f219-4535-baf0-dd2b58607c89" }
  ],
  "observability": { "enabled": true }
}
