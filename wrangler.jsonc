{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mizan-gpp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["* * * * *"] },
  "ai": { "binding": "AI" },
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "mizan-gpp-media" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "mizan-gpp", "database_id": "9f343c55-f219-4535-baf0-dd2b58607c89" }
  ],
  "observability": { "enabled": true }
}
