{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mizan-gpp.the-montiapple.workers.dev/v1/schemas/secrets-config.json",
  "description": "secrets.cms.json — per-project secrets (spec/secrets.md §3): NAME → literal or EnvRef resolved by the sync client; values never live in git.",
  "type": "object",
  "patternProperties": {
    "^[A-Z][A-Z0-9_]*$": {
      "$ref": "https://mizan-gpp.the-montiapple.workers.dev/v1/schemas/env-ref.json#/$defs/configString"
    }
  },
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    }
  }
}
