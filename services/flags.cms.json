{
  "config": {
    "flags": {
      "advanced-export": {
        "defaultValue": false,
        "description": "The premium CSV/JSON export UI \u2014 pro plans only.",
        "rules": [
          {
            "value": true,
            "when": {
              "entitlement": [
                "pro"
              ]
            }
          }
        ],
        "type": "boolean"
      },
      "owns-lifetime": {
        "defaultValue": false,
        "description": "The signed-in user owns Lifetime.",
        "rules": [
          {
            "value": true,
            "when": {
              "entitlement": [
                "lifetime"
              ]
            }
          }
        ],
        "type": "boolean"
      },
      "owns-pro": {
        "defaultValue": false,
        "description": "The signed-in user owns Pro.",
        "rules": [
          {
            "value": true,
            "when": {
              "entitlement": [
                "pro"
              ]
            }
          }
        ],
        "type": "boolean"
      },
      "welcome-banner": {
        "defaultValue": "Build a backend in git.",
        "type": "string"
      }
    }
  },
  "description": "OpenFeature flags: a static welcome-banner string + a pro-gated advanced-export boolean (composes with billing entitlements).",
  "kind": "flags",
  "provider": "local"
}
